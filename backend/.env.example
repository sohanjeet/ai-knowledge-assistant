# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=ai_knowledge_assistant
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Max upload size for documents, in MB
DOCUMENT_MAX_UPLOAD_MB=10

# Text chunking, in characters. Size > 0, overlap >= 0 and overlap < size.
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200

# Embeddings. Only "openai" is implemented. Embeddings are generated by an explicit service
# call, never during upload, so upload/extraction/chunking and the tests work without a key.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the DocumentChunk.embedding vector column (1536); changing it needs a migration.
EMBEDDING_DIMENSIONS=1536
# Leave empty unless you generate embeddings. Never commit a real key.
OPENAI_API_KEY=
